<%# app/views/bible_story_entries/show.html.erb %>
<%
  category_labels = {
    "main_plot"      => "Main Plot",
    "subplot"        => "Subplot",
    "watch_list"     => "Watch List",
    "theme"          => "Theme",
    "world_building" => "World Building"
  }
%>
<% content_for :title, "#{@entry.title} — Story Entries — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Bible", novel_bible_path(@novel)],
      ["Story Entries", novel_bible_story_entries_path(@novel)],
      [@entry.title, nil]
    ] %>

<div class="page-header">
  <div class="page-header__row">
    <div>
      <h1 class="page-title" data-testid="entry-title"><%= @entry.title %></h1>
      <p class="page-subtitle"><%= category_labels[@entry.category] %></p>
    </div>
    <div class="btn-group">
      <%= link_to "Edit", edit_novel_bible_story_entry_path(@novel, @entry), class: "btn btn--secondary btn--sm" %>
      <%= modal_button_to "Remove", novel_bible_story_entry_path(@novel, @entry),
            method:        :delete,
            message:       "Remove \"#{@entry.title}\"?",
            confirm_label: "Remove" %>
    </div>
  </div>
</div>

<div class="card bible-entry">
  <div class="bible-entry__meta">
    <% if @entry.first_appearance_chapter.present? %>
      <div class="bible-entry__meta-item">
        <span class="bible-entry__meta-label">First appears</span>
        <span class="bible-entry__meta-value">Ch. <%= @entry.first_appearance_chapter %></span>
      </div>
    <% end %>
  </div>

  <% if @entry.content.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Content</h2>
      <div class="bible-entry__body"><%= simple_format @entry.content %></div>
    </div>
  <% end %>

  <% if @entry.notes.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Notes</h2>
      <div class="bible-entry__body"><%= simple_format @entry.notes %></div>
    </div>
  <% end %>

  <p class="bible-entry__updated-at">Last updated: <%= @entry.last_updated_at&.strftime("%B %-d, %Y") || "—" %></p>
</div>
