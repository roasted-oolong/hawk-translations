<%# app/views/bible_story_entries/edit.html.erb %>
<% content_for :title, "Edit #{@entry.title} — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Bible", novel_bible_path(@novel)],
      ["Story Entries", novel_bible_story_entries_path(@novel)],
      [@entry.title, novel_bible_story_entry_path(@novel, @entry)],
      ["Edit", nil]
    ] %>

<div class="page-header">
  <h1 class="page-title">Edit Story Entry</h1>
  <p class="page-subtitle"><%= @entry.title %></p>
</div>

<div class="card">
  <%= render "form" %>
</div>
