<%# app/views/chapter_review/tab.html.erb %>
<% content_for :title, "Review — #{@novel.title} — Hawk" %>

<%= turbo_frame_tag "tab-panel-review" do %>

<div class="chapter-review-tab" data-testid="chapter-review-tab">

  <div class="chapter-review-tab__header">
    <h2 class="chapter-review-tab__title">Translated Chapters</h2>
  </div>

  <% if @chapters_for_review.empty? %>
    <div class="chapter-review-tab__empty" data-testid="chapter-review-empty">
      <% if @reviewed_count == @total_count && @total_count > 0 %>
        <p>All <%= @total_count %> <%= "chapter".pluralize(@total_count) %> reviewed.</p>
      <% else %>
        <p>No translated chapters ready for review yet.</p>
      <% end %>
    </div>
  <% else %>
    <div class="chapter-review-tab__card" data-testid="chapter-review-card">
      <div class="chapter-review-tab__card-body">
        <p class="chapter-review-tab__ready-count">
          <%= @chapters_for_review.size %> <%= "chapter".pluralize(@chapters_for_review.size) %> ready to review
        </p>
        <p class="chapter-review-tab__chapter-list">
          <%= @chapters_for_review.map { |c| "Ch. #{c.number}" }.join(" · ") %>
        </p>
      </div>
      <%= link_to "Review Chapters",
            novel_chapter_review_path(@novel),
            class: "btn btn--primary",
            data: { turbo_frame: "_top", testid: "button-review-chapters" } %>
    </div>
  <% end %>

  <%# Pushed up to date over Turbo Streams as preread jobs progress — see
      TranslationJob#broadcast_preread_entries_status and the
      turbo_stream_from "novel_#{@novel.id}_preread" subscription in
      novels/show.html.erb. This render is just the initial page load. %>
  <%= render "chapter_review/preread_entries_status",
        novel: @novel, pending_count: @pending_count, pending_breakdown: @pending_breakdown %>

</div>

<% end %><%# /turbo-frame tab-panel-review %>
