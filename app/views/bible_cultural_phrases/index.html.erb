<%# app/views/bible_cultural_phrases/index.html.erb %>
<% content_for :title, "Cultural Phrases — #{@novel.title} — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Bible", novel_bible_path(@novel)],
      ["Cultural Phrases", nil]
    ] %>

<div class="page-header">
  <div class="page-header__row">
    <h1 class="page-title">Cultural Phrases</h1>
    <%= link_to "Add Phrase", new_novel_bible_cultural_phrase_path(@novel), class: "btn btn--primary btn--sm" %>
  </div>
</div>

<% if @entries.none? %>
  <div class="empty-state" data-testid="cultural-phrases-empty">
    <p class="empty-state__message">No cultural phrases yet.</p>
    <%= link_to "Add the first phrase \u2192", new_novel_bible_cultural_phrase_path(@novel) %>
  </div>
<% else %>
  <div class="data-table-wrapper">
    <table class="data-table" data-testid="cultural-phrases-table">
      <thead>
        <tr>
          <th class="data-table__th">Phrase</th>
          <th class="data-table__th">Korean Phrase</th>
          <th class="data-table__th">Established Translation</th>
          <th class="data-table__th">First Appears</th>
          <th class="data-table__th data-table__th--actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr class="data-table__row">
            <td class="data-table__td data-table__td--title">
              <%= link_to entry.phrase, novel_bible_cultural_phrase_path(@novel, entry), class: "data-table__link" %>
            </td>
            <td class="data-table__td bible-td--korean"><%= entry.korean_phrase.presence || "—" %></td>
            <td class="data-table__td"><%= entry.established_translation.presence || "—" %></td>
            <td class="data-table__td"><%= entry.first_appearance_chapter ? "Ch. #{entry.first_appearance_chapter}" : "—" %></td>
            <td class="data-table__td data-table__td--actions">
              <%= link_to "Edit", edit_novel_bible_cultural_phrase_path(@novel, entry), class: "btn btn--ghost btn--sm" %>
              <%= button_to "Remove", novel_bible_cultural_phrase_path(@novel, entry), method: :delete,
                  class: "btn btn--danger btn--sm",
                  data: { turbo_confirm: "Remove \"#{entry.phrase}\"?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
