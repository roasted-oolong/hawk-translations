<%# app/views/bible_cultural_phrases/show.html.erb %>
<% content_for :title, "#{@entry.phrase} — Cultural Phrases — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Bible", novel_bible_path(@novel)],
      ["Cultural Phrases", novel_bible_cultural_phrases_path(@novel)],
      [@entry.phrase, nil]
    ] %>

<div class="page-header">
  <div class="page-header__row">
    <div>
      <h1 class="page-title" data-testid="entry-title"><%= @entry.phrase %></h1>
      <% if @entry.korean_phrase.present? %>
        <p class="page-subtitle bible-entry__korean"><%= @entry.korean_phrase %></p>
      <% end %>
    </div>
    <div class="btn-group">
      <%= link_to "Edit", edit_novel_bible_cultural_phrase_path(@novel, @entry), class: "btn btn--secondary btn--sm" %>
      <%= modal_button_to "Remove", novel_bible_cultural_phrase_path(@novel, @entry),
            method:        :delete,
            message:       "Remove \"#{@entry.phrase}\"?",
            confirm_label: "Remove" %>
    </div>
  </div>
</div>

<div class="card bible-entry">
  <div class="bible-entry__meta">
    <% if @entry.established_translation.present? %>
      <div class="bible-entry__meta-item">
        <span class="bible-entry__meta-label">Established translation</span>
        <span class="bible-entry__meta-value bible-entry__meta-value--highlight"><%= @entry.established_translation %></span>
      </div>
    <% end %>
    <% if @entry.first_appearance_chapter.present? %>
      <div class="bible-entry__meta-item">
        <span class="bible-entry__meta-label">First appears</span>
        <span class="bible-entry__meta-value">Ch. <%= @entry.first_appearance_chapter %></span>
      </div>
    <% end %>
  </div>

  <% if @entry.literal_translation.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Literal Translation</h2>
      <div class="bible-entry__body"><%= simple_format @entry.literal_translation %></div>
    </div>
  <% end %>

  <% if @entry.intended_meaning.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Intended Meaning</h2>
      <div class="bible-entry__body"><%= simple_format @entry.intended_meaning %></div>
    </div>
  <% end %>

  <% if @entry.context.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Context</h2>
      <div class="bible-entry__body"><%= simple_format @entry.context %></div>
    </div>
  <% end %>

  <% if @entry.notes.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Notes</h2>
      <div class="bible-entry__body"><%= simple_format @entry.notes %></div>
    </div>
  <% end %>

  <p class="bible-entry__updated-at">Last updated: <%= @entry.last_updated_at&.strftime("%B %-d, %Y") || "—" %></p>
</div>
