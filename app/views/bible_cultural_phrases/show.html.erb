<h1><%= @entry.phrase %></h1>
<% if @entry.korean_phrase.present? %>
  <p><em><%= @entry.korean_phrase %></em></p>
<% end %>

<p>
  <%= link_to "← All Cultural Phrases", novel_bible_cultural_phrases_path(@novel) %> |
  <%= link_to "Edit", edit_novel_bible_cultural_phrase_path(@novel, @entry) %> |
  <%= button_to "Remove", novel_bible_cultural_phrase_path(@novel, @entry), method: :delete,
      data: { turbo_confirm: "Remove \"#{@entry.phrase}\"?" } %>
</p>

<hr>

<% if @entry.established_translation.present? %>
  <p><strong>Established Translation:</strong> <%= @entry.established_translation %></p>
<% end %>

<% if @entry.first_appearance_chapter.present? %>
  <p><strong>First Appearance:</strong> Chapter <%= @entry.first_appearance_chapter %></p>
<% end %>

<% if @entry.literal_translation.present? %>
  <h2>Literal Translation</h2>
  <p><%= simple_format @entry.literal_translation %></p>
<% end %>

<% if @entry.intended_meaning.present? %>
  <h2>Intended Meaning</h2>
  <p><%= simple_format @entry.intended_meaning %></p>
<% end %>

<% if @entry.context.present? %>
  <h2>Context</h2>
  <p><%= simple_format @entry.context %></p>
<% end %>

<% if @entry.notes.present? %>
  <h2>Notes</h2>
  <p><%= simple_format @entry.notes %></p>
<% end %>

<p class="muted">Last updated: <%= @entry.last_updated_at&.strftime("%B %-d, %Y") || "—" %></p>
