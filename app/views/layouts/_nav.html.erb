<%# app/views/layouts/_nav.html.erb
  Top navigation bar. Rendered on every authenticated page.
  data-testid="app-nav" is used by system specs.
%>
<nav class="app-nav" data-testid="app-nav" aria-label="Main navigation">
  <div class="app-nav__inner">

    <%# Brand / home link %>
    <%= link_to root_path, class: "app-nav__brand", aria: { label: "Hawk Translations home" } do %>
      <span class="app-nav__brand-mark" aria-hidden="true">鷹</span>
      <span class="app-nav__brand-name">Hawk</span>
    <% end %>

    <%# Right-side actions %>
    <div class="app-nav__actions">
    </div>

  </div>
</nav>
