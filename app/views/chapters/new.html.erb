<%# app/views/chapters/new.html.erb %>
<% content_for :title, "Upload Chapter(s) — #{@novel.title} — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Chapters", novel_chapters_path(@novel)],
      ["Upload", nil]
    ] %>

<div class="page-header">
  <h1 class="page-title">Upload Chapter(s)</h1>
  <p class="page-subtitle">
    Upload a single chapter with an explicit number, or drop multiple Korean
    source files and chapter numbers will be parsed from filenames automatically.
  </p>
</div>

<div class="upload-panels">

  <%# ------------------------------------------------------------------ %>
  <%# Panel A — Bulk upload                                               %>
  <%# ------------------------------------------------------------------ %>
  <div class="card upload-panel" data-testid="bulk-upload-fieldset">
    <div class="upload-panel__header">
      <h2 class="upload-panel__title">Bulk upload</h2>
      <p class="upload-panel__description">
        Select multiple <code>ch{N}_korean</code> or <code>Chapter_{N}...</code>
        files. Chapter numbers are parsed from filenames automatically.
      </p>
    </div>

    <%= form_with url: novel_chapters_path(@novel), multipart: true,
          html: { class: "upload-panel__form" } do |f| %>
      <div class="form-group">
        <%= f.label :korean_source, "Korean source files",
              for: "bulk_korean_source", class: "form-label" %>
        <div class="file-upload"
             data-controller="file-upload"
             data-action="dragover->file-upload#onDragOver dragleave->file-upload#onDragLeave drop->file-upload#onDrop">
          <%= f.file_field :korean_source,
                id: "bulk_korean_source",
                name: "chapter[korean_source][]",
                multiple: true,
                accept: "text/plain,.txt",
                class: "sr-only",
                "data-file-upload-target": "input",
                "data-action": "change->file-upload#onChange",
                "data-testid": "bulk-file-input" %>
          <label for="bulk_korean_source"
                 class="file-upload__zone"
                 data-file-upload-target="zone">
            <strong>Click to browse</strong> or drag files here
            <p class="file-upload__zone-hint">Accepts .txt &mdash; numbers parsed from filenames</p>
          </label>
          <div class="file-upload__preview file-upload__preview--empty"
               data-file-upload-target="preview"></div>
        </div>
      </div>
      <div class="form-actions">
        <%= f.submit "Upload files", class: "btn btn--primary",
              data: { "file-upload-target": "submit" },
              disabled: true %>
      </div>
    <% end %>
  </div>

  <%# ------------------------------------------------------------------ %>
  <%# Panel B — Single chapter upload                                     %>
  <%# ------------------------------------------------------------------ %>
  <div class="card upload-panel" data-testid="single-upload-fieldset">
    <div class="upload-panel__header">
      <h2 class="upload-panel__title">Single chapter</h2>
      <p class="upload-panel__description">
        Upload one chapter with an explicit chapter number.
      </p>
    </div>

    <%= form_with url: novel_chapters_path(@novel), multipart: true,
          html: { class: "upload-panel__form" } do |f| %>
      <div class="form-group">
        <%= f.label :number, "Chapter number", class: "form-label" %>
        <%= f.number_field :number,
              name: "chapter[number]",
              min: 1,
              class: "form-input",
              placeholder: "e.g. 5" %>
      </div>

      <div class="form-group">
        <%= f.label :title, "Title (optional subtitle)", class: "form-label" %>
        <%= f.text_field :title,
              name: "chapter[title]",
              class: "form-input",
              placeholder: "e.g. The Manager's Regression" %>
      </div>

      <div class="form-group">
        <%= f.label :korean_source, "Korean source file",
              for: "single_korean_source", class: "form-label" %>
        <div class="file-upload"
             data-controller="file-upload"
             data-action="dragover->file-upload#onDragOver dragleave->file-upload#onDragLeave drop->file-upload#onDrop">
          <%= f.file_field :korean_source,
                id: "single_korean_source",
                name: "chapter[korean_source][]",
                multiple: false,
                accept: "text/plain,.txt",
                class: "sr-only",
                "data-file-upload-target": "input",
                "data-action": "change->file-upload#onChange" %>
          <label for="single_korean_source"
                 class="file-upload__zone"
                 data-file-upload-target="zone">
            <strong>Click to browse</strong> or drag a file here
            <p class="file-upload__zone-hint">Accepts .txt files</p>
          </label>
          <div class="file-upload__preview file-upload__preview--empty"
               data-file-upload-target="preview"></div>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :status, "Status", class: "form-label" %>
        <%= f.select :status,
              options_for_select(
                Chapter.statuses.keys.map { |s| [s.humanize, s] },
                "untranslated"
              ),
              {},
              name: "chapter[status]",
              class: "form-select" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Upload", class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>

</div>
