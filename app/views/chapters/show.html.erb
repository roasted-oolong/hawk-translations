<h2>Chapter <%= @chapter.number %><% if @chapter.title.present? %> — <%= @chapter.title %><% end %></h2>

<p>
  <strong>Novel:</strong> <%= link_to @novel.title, @novel %> |
  <strong>Status:</strong> <%= @chapter.status %>
</p>

<table>
  <tr>
    <th>Korean Source</th>
    <td>
      <% if @chapter.korean_source.attached? %>
        <%= link_to "Download", download_korean_source_novel_chapter_path(@novel, @chapter) %>
      <% else %>
        Not uploaded
      <% end %>
    </td>
  </tr>
  <tr>
    <th>Translated Output</th>
    <td>
      <% if @chapter.translated_output.attached? %>
        <%= link_to "Download", download_translated_output_novel_chapter_path(@novel, @chapter) %>
      <% else %>
        Not available
      <% end %>
    </td>
  </tr>
</table>

<p>
  <%= link_to "Edit", edit_novel_chapter_path(@novel, @chapter) %> |
  <%= link_to "Back to chapters", novel_path(@novel) %>
</p>
