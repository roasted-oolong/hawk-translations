<%# app/views/chapters/show.html.erb %>
<% content_for :title, "Chapter #{@chapter.number} — #{@novel.title} — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Chapter #{@chapter.number}", nil]
    ] %>

<div class="page-header">
  <div class="page-header__row">
    <div>
      <h1 class="page-title">
        Chapter <%= @chapter.number %>
        <% if @chapter.title.present? %>
          <span class="page-title__sub">— <%= @chapter.title %></span>
        <% end %>
      </h1>
    </div>
    <div class="btn-group">
      <%= link_to "Edit", edit_novel_chapter_path(@novel, @chapter),
            class: "btn btn--secondary btn--sm" %>
      <%= modal_button_to "Remove", novel_chapter_path(@novel, @chapter),
            method:        :delete,
            message:       "Remove Chapter #{@chapter.number}? This cannot be undone.",
            confirm_label: "Remove" %>
    </div>
  </div>
  <div class="chapter-show__meta">
    <span class="chapter-show__meta-item">
      <span class="chapter-show__meta-label">Status</span>
      <%= render "components/status_badge", status: @chapter.status %>
    </span>
  </div>
</div>

<div class="card chapter-show__files">
  <h2 class="chapter-show__files-title">Files</h2>
  <div class="chapter-show__file-row">
    <span class="chapter-show__file-label">Korean Source</span>
    <span class="chapter-show__file-value">
      <% if @chapter.korean_source.attached? %>
        <%= link_to "Download",
              download_korean_source_novel_chapter_path(@novel, @chapter),
              class: "btn btn--secondary btn--sm" %>
      <% else %>
        <span class="text-muted">Not uploaded</span>
      <% end %>
    </span>
  </div>
  <div class="chapter-show__file-row">
    <span class="chapter-show__file-label">Translated Output</span>
    <span class="chapter-show__file-value">
      <% if @chapter.translated_output.attached? %>
        <%= link_to "Download",
              download_translated_output_novel_chapter_path(@novel, @chapter),
              class: "btn btn--secondary btn--sm" %>
      <% else %>
        <span class="text-muted">Not available yet</span>
      <% end %>
    </span>
  </div>
</div>
