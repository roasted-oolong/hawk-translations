<%# app/views/chapters/_korean_pane.html.erb
    Rendered by chapters/show.html.erb, and re-broadcast live by
    Chapter#broadcast_status_change / #broadcast_korean_pane whenever the
    korean_source attachment changes — so clicking KO right after OCR
    finishes shows the transcribed text without a manual page refresh. %>
<% korean_text = chapter.korean_source.attached? ? chapter.korean_source.download.force_encoding("UTF-8") : nil %>
<div class="chapter-review__korean-pane chapter-viewer__korean-pane"
     id="chapter-korean-pane-<%= chapter.id %>"
     data-chapter-viewer-target="koreanPane">
  <% ko_paras = (korean_text || "").split(/\n\n+/).map(&:strip).reject(&:empty?) %>
  <% if ko_paras.any? %>
    <% ko_paras.each do |para| %>
      <p class="chapter-review__korean-para" lang="ko"><%= para %></p>
    <% end %>
  <% else %>
    <p class="chapter-review__korean-empty">—</p>
  <% end %>
</div>
