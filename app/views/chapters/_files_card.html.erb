<%# app/views/chapters/_files_card.html.erb
    Rendered by chapters/show.html.erb, and re-broadcast live by
    Chapter#broadcast_status_change whenever status changes (see
    app/models/chapter.rb) — swaps between the processing banner and the
    normal Files rows without a page reload once OcrChapterJob finishes. %>
<div class="card chapter-show__files" id="chapter-files-<%= chapter.id %>">
  <% if chapter.ocr_processing? %>
    <div class="chapter-show__ocr-processing" data-testid="ocr-processing-banner">
      <span class="chapter-show__spinner" aria-hidden="true"></span>
      <p class="chapter-show__ocr-processing-text">
        Extracting text from photos&hellip; this can take a couple of minutes.
      </p>
    </div>
  <% else %>
    <h2 class="chapter-show__files-title">Files</h2>
    <div class="chapter-show__file-row">
      <span class="chapter-show__file-label">Korean Source</span>
      <span class="chapter-show__file-value">
        <% if chapter.korean_source.attached? %>
          <%= link_to "Download",
                download_korean_source_novel_chapter_path(chapter.novel, chapter),
                class: "btn btn--secondary btn--sm" %>
        <% else %>
          <span class="text-muted">Not uploaded</span>
        <% end %>
      </span>
    </div>
    <div class="chapter-show__file-row">
      <span class="chapter-show__file-label">Translated Output</span>
      <span class="chapter-show__file-value">
        <% if chapter.translated_output.attached? %>
          <%= link_to "Download",
                download_translated_output_novel_chapter_path(chapter.novel, chapter),
                class: "btn btn--secondary btn--sm" %>
        <% else %>
          <span class="text-muted">Not available yet</span>
        <% end %>
      </span>
    </div>
  <% end %>
</div>
