<%# app/views/chapters/index.html.erb %>
<% content_for :title, "Chapters — #{@novel.title} — Hawk" %>

<%# Breadcrumb outside the frame — shown on direct page visits, ignored in the tab panel %>
<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Chapters", nil]
    ] %>

<%= turbo_frame_tag "tab-panel-chapters" do %>

  <div data-controller="chapter-select bulk-translate">

    <%# ── Tab panel toolbar ───────────────────────────────────────────────── %>
    <div class="tab-panel-toolbar">
      <h2 class="tab-panel-toolbar__title">Chapters</h2>
      <div class="tab-panel-toolbar__actions">
        <%= link_to "Upload Chapters",
              new_novel_chapter_path(@novel),
              class: "btn btn--secondary btn--sm",
              data: { turbo_frame: "_top", testid: "link-upload-chapters" } %>
        <button type="button"
                class="btn btn--primary btn--sm"
                data-action="click->bulk-translate#open"
                data-testid="button-bulk-translate">
          Translate Chapters
        </button>
      </div>
    </div>

    <%# ── Chapter table ───────────────────────────────────────────────────── %>
    <% if @chapters.none? %>
      <div class="empty-state" data-testid="chapters-empty">
        <p class="empty-state__message">No chapters yet.</p>
        <p class="empty-state__action">
          <%= link_to "Upload the first chapter",
                new_novel_chapter_path(@novel),
                class: "btn btn--primary",
                data: { turbo_frame: "_top" } %>
        </p>
      </div>
    <% else %>

      <%# ── Selection action bar (hidden until rows are checked) ─────────── %>
      <div class="chapter-select-bar"
           data-chapter-select-target="actionBar"
           hidden>
        <span class="chapter-select-bar__count">
          <span data-chapter-select-target="counter">0</span> selected
        </span>
        <div class="chapter-select-bar__actions">

          <%= form_with url: bulk_update_novel_chapters_path(@novel), method: :patch,
                data: { chapter_select_target: "editForm" } do |f| %>
            <%= f.select :status,
                  Chapter.statuses.keys.map { |s| [s.humanize, s] },
                  {},
                  class: "form-select chapter-select-bar__select" %>
            <%= f.submit "Update Status", class: "btn btn--ghost btn--sm" %>
          <% end %>

          <%= form_with url: bulk_download_novel_chapters_path(@novel), method: :post,
                data: { chapter_select_target: "downloadForm", turbo: false } do |f| %>
            <%= f.submit "Download", class: "btn btn--ghost btn--sm" %>
          <% end %>

          <%= form_with url: bulk_destroy_novel_chapters_path(@novel), method: :delete,
                data: { chapter_select_target: "deleteForm",
                        turbo_confirm: "Delete the selected chapters? This cannot be undone." } do |f| %>
            <%= f.submit "Delete", class: "btn btn--danger btn--sm" %>
          <% end %>

          <div data-chapter-select-target="bulkTranslateForm" hidden>
            <%= form_with url: novel_translation_jobs_path(@novel),
                  method: :post,
                  scope: :translation_job do |f| %>
              <%= f.hidden_field :job_type, value: "translate_batch" %>
              <%= f.hidden_field :chapter_start, value: "", data: { "chapter-select-target": "bulkTranslateStart" } %>
              <%= f.hidden_field :chapter_end,   value: "", data: { "chapter-select-target": "bulkTranslateEnd" } %>
              <%= f.submit "Translate Chapters", class: "btn btn--primary btn--sm" %>
            <% end %>
          </div>

          <div data-chapter-select-target="bulkPrereadForm" hidden>
            <%= form_with url: novel_translation_jobs_path(@novel),
                  method: :post,
                  scope: :translation_job do |f| %>
              <%= f.hidden_field :job_type, value: "preread" %>
              <%= f.hidden_field :chapter_start, value: "", data: { "chapter-select-target": "bulkPrereadStart" } %>
              <%= f.hidden_field :chapter_end,   value: "", data: { "chapter-select-target": "bulkPrereadEnd" } %>
              <%= f.submit "Bulk Pre-read", class: "btn btn--primary btn--sm" %>
            <% end %>
          </div>

        </div>
      </div>

      <% if @cancellable_jobs.any? %>
        <div data-controller="poll"
             data-poll-interval-value="1000"
             data-poll-url-value="<%= novel_chapters_path(@novel) %>">
      <% end %>

      <%= turbo_frame_tag "chapters-table" do %>
      <div class="data-table-wrapper">
        <table class="data-table" data-testid="chapters-table">
          <thead>
            <tr>
              <th class="data-table__th data-table__th--checkbox">
                <input type="checkbox"
                       data-chapter-select-target="selectAll"
                       data-action="change->chapter-select#toggleAll">
              </th>
              <th class="data-table__th data-table__th--number">#</th>
              <th class="data-table__th">Title</th>
              <th class="data-table__th">Status</th>
              <th class="data-table__th data-table__th--actions"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @chapters.each do |chapter| %>
              <% cancel_job = @cancellable_jobs[chapter.number] %>
              <tr class="data-table__row">
                <td class="data-table__td data-table__td--checkbox">
                  <input type="checkbox"
                         value="<%= chapter.id %>"
                         data-chapter-select-target="checkbox"
                         data-action="change->chapter-select#update"
                         data-status="<%= chapter.status %>"
                         data-number="<%= chapter.number %>">
                </td>
                <td class="data-table__td data-table__td--number">
                  <%= link_to chapter.number, novel_chapter_path(@novel, chapter),
                        class: "data-table__link",
                        data: { turbo_frame: "_top" } %>
                </td>
                <td class="data-table__td data-table__td--title">
                  <%= chapter.title.presence || %(<span class="text-muted">—</span>).html_safe %>
                </td>
                <td class="data-table__td">
                  <% if cancel_job %>
                    <% job_label = "#{cancel_job.job_type.humanize} [#{cancel_job.queued? ? 'Queued' : 'In Progress'}]" %>
                    <%= render "components/status_badge", status: cancel_job.status, label: job_label %>
                  <% else %>
                    <%= render "components/status_badge", status: chapter.status %>
                  <% end %>
                </td>
                <td class="data-table__td data-table__td--actions">
                  <% if cancel_job %>
                    <% if cancel_job.shows_progress? && cancel_job.progress_pct %>
                      <span class="chapter-job-progress"><%= cancel_job.progress_pct %>%</span>
                    <% end %>
                    <%= modal_button_to "Cancel", novel_translation_job_path(@novel, cancel_job),
                          method:        :delete,
                          message:       "Cancel the queued job for Chapter #{chapter.number}? It cannot be restarted.",
                          confirm_label: "Cancel job",
                          button_class:  "btn btn--danger btn--xs" %>
                  <% elsif chapter.prereading? %>
                    <span class="chapter-action--pending">Running…</span>
                  <% elsif chapter.untranslated? || chapter.preread_failed? %>
                    <%= form_with url: novel_translation_jobs_path(@novel),
                          method: :post,
                          scope: :translation_job,
                          data: { turbo_frame: "tab-panel-chapters" } do |f| %>
                      <%= f.hidden_field :job_type, value: "preread" %>
                      <%= f.hidden_field :chapter_start, value: chapter.number %>
                      <%= f.hidden_field :chapter_end,   value: chapter.number %>
                      <%= f.submit "Preread",
                            class: "btn btn--ghost btn--xs",
                            data: { testid: "btn-preread-#{chapter.number}" } %>
                    <% end %>
                  <% elsif chapter.preread? %>
                    <%= form_with url: novel_translation_jobs_path(@novel),
                          method: :post,
                          scope: :translation_job,
                          data: { turbo_frame: "tab-panel-chapters" } do |f| %>
                      <%= f.hidden_field :job_type, value: "translate_batch" %>
                      <%= f.hidden_field :chapter_start, value: chapter.number %>
                      <%= f.hidden_field :chapter_end,   value: chapter.number %>
                      <%= f.submit "Translate",
                            class: "btn btn--ghost btn--xs chapter-action--translate",
                            data: { testid: "btn-translate-#{chapter.number}" } %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% end %><%# /turbo-frame chapters-table %>

      <% if @cancellable_jobs.any? %>
        </div>
      <% end %>

    <% end %>

    <%# ── Bulk Translate dialog ───────────────────────────────────────────── %>
    <% preread_chapters = @chapters.select(&:preread?) %>
    <dialog class="bulk-translate-dialog"
            data-bulk-translate-target="dialog"
            data-testid="bulk-translate-dialog">
      <%= form_with url: novel_translation_jobs_path(@novel),
            method: :post do |f| %>
        <%= f.hidden_field :job_type, value: "translate_batch" %>
        <%= f.hidden_field :chapter_start, data: { "bulk-translate-target": "chapterStart" } %>
        <%= f.hidden_field :chapter_end,   data: { "bulk-translate-target": "chapterEnd" } %>

        <div class="bulk-translate-dialog__panel">
          <div class="bulk-translate-dialog__header">
            <div>
              <h2 class="bulk-translate-dialog__title">Bulk Translation</h2>
              <p class="bulk-translate-dialog__subtitle"><%= @novel.title %></p>
            </div>
          </div>

          <% if preread_chapters.empty? %>
            <p class="bulk-translate-dialog__empty">No chapters are ready for translation yet.</p>
          <% else %>
            <div class="bulk-translate-dialog__select-all">
              <label class="bulk-translate-dialog__check-label">
                <input type="checkbox"
                       class="bulk-translate-dialog__checkbox"
                       data-bulk-translate-target="selectAll"
                       data-action="change->bulk-translate#toggleAll">
                Select all
              </label>
              <span class="bulk-translate-dialog__count-label">
                <span data-bulk-translate-target="counter">0</span> selected
              </span>
            </div>

            <div class="bulk-translate-dialog__list">
              <% preread_chapters.each do |chapter| %>
                <label class="bulk-translate-dialog__chapter-row">
                  <input type="checkbox"
                         class="bulk-translate-dialog__checkbox"
                         value="<%= chapter.number %>"
                         data-bulk-translate-target="checkbox"
                         data-action="change->bulk-translate#updateSelection">
                  <span>Chapter <%= chapter.number %></span>
                  <% if chapter.title.present? %>
                    <span class="bulk-translate-dialog__chapter-title">— <%= chapter.title %></span>
                  <% end %>
                </label>
              <% end %>
            </div>
          <% end %>

          <div class="bulk-translate-dialog__actions">
            <button type="button"
                    class="btn btn--ghost"
                    data-action="click->bulk-translate#close">Cancel</button>
            <%= f.submit "Translate",
                  class: "btn btn--primary",
                  disabled: true,
                  data: {
                    "bulk-translate-target": "submitBtn",
                    testid: "btn-bulk-translate-submit"
                  } %>
          </div>
        </div>
      <% end %>
    </dialog>

  </div><%# /data-controller="chapter-select bulk-translate" %>

<% end %><%# /turbo-frame tab-panel-chapters %>
