<h1>Novels</h1>

<%= link_to "New Novel", new_novel_path %>

<% if @novels.none? %>
  <p>No novels yet.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Korean Title</th>
        <th>Series</th>
        <th>Genre</th>
        <th>Chapters</th>
        <th>Visibility</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @novels.each do |novel| %>
        <tr>
          <td><%= link_to novel.title, novel %></td>
          <td><%= novel.korean_title %></td>
          <td><%= novel.series&.name %></td>
          <td><%= novel.genre %></td>
          <td><%= novel.chapters.size %></td>
          <td><%= novel.visibility %></td>
          <td>
            <%= link_to "Edit", edit_novel_path(novel) %> |
            <%= button_to "Remove", novel, method: :delete, data: { turbo_confirm: "Remove this novel?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
