<%# app/views/novels/_form.html.erb %>
<%#
  Locals:
    novel  — the Novel instance (new or persisted)
    editing — boolean, true when called from edit.html.erb

  Instance variables expected from NovelsController#set_form_collections:
    @series_options    — ActiveRecord relation of Series scoped to the novel's org
    @poc_user_options  — ActiveRecord relation of Users scoped to the novel's org members
%>
<%= form_with model: novel, multipart: true, data: { testid: "novel-form" } do |f| %>
  <% if novel.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p class="form-errors__summary">
        <%= pluralize(novel.errors.count, "error") %> prevented this novel from being saved:
      </p>
      <ul class="form-errors__list">
        <% novel.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# --- Two-column grid: short fields --- %>
  <div class="novel-form__grid">
    <div class="form-group">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-input", autofocus: !editing %>
    </div>

    <div class="form-group">
      <%= f.label :korean_title, "Korean title", class: "form-label" %>
      <%= f.text_field :korean_title, class: "form-input" %>
    </div>

    <% if editing %>
      <%# directory_name is read-only after creation. Show as static text so
          the user understands the value but cannot accidentally change it. %>
      <div class="form-group">
        <span class="form-label">Directory name</span>
        <p class="novel-form__readonly" data-testid="directory-name-readonly">
          <%= novel.directory_name %>
        </p>
        <span class="form-hint">
          The pipeline directory cannot be renamed after creation.
          Contact a developer if a rename is required.
        </span>
      </div>
    <% else %>
      <div class="form-group">
        <%= f.label :directory_name, "Directory name", class: "form-label" %>
        <%= f.text_field :directory_name, class: "form-input",
              placeholder: "e.g. idols-rewind" %>
        <span class="form-hint">
          The exact folder name on disk. Must match the novel's pipeline directory.
        </span>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :genre, class: "form-label" %>
      <%= f.text_field :genre, class: "form-input", placeholder: "e.g. Romance, Fantasy" %>
    </div>

    <div class="form-group">
      <%= f.label :visibility, class: "form-label" %>
      <%= f.select :visibility,
            Novel.visibilities.keys.map { |v| [v.humanize, v] },
            {},
            class: "form-select" %>
    </div>

    <div class="form-group">
      <%= f.label :series_id, "Series", class: "form-label" %>
      <%= f.select :series_id,
            @series_options.map { |s| [s.name, s.id] },
            { include_blank: "— None —" },
            class: "form-select" %>
    </div>

    <div class="form-group">
      <%= f.label :poc_user_id, "Point of contact", class: "form-label" %>
      <%= f.select :poc_user_id,
            @poc_user_options.map { |u| [u.name, u.id] },
            { include_blank: "— Not assigned —" },
            class: "form-select" %>
    </div>
  </div>

  <%# --- Cover art --- %>
  <div class="form-group">
    <%= f.label :cover_art, "Cover art", class: "form-label" %>

    <% if editing && novel.cover_art.attached? && novel.cover_art.blob.persisted? %>
      <%# Show current thumbnail with a remove button on the edit form %>
      <div class="novel-form__cover-current" data-testid="cover-art-current">
        <%= image_tag novel.cover_art,
              alt: "Current cover art",
              class: "novel-form__cover-thumb" %>
        <%= link_to "Remove cover art",
              cover_art_novel_path(novel),
              data: { turbo_method: :delete },
              class: "btn btn--ghost btn--sm novel-form__cover-remove" %>
      </div>
      <span class="form-hint">Upload a new file below to replace the current cover.</span>
    <% end %>

    <div class="file-upload"
         data-controller="file-upload"
         data-testid="cover-art-upload"
         data-action="dragover->file-upload#onDragOver dragleave->file-upload#onDragLeave drop->file-upload#onDrop">
      <%= f.file_field :cover_art,
            accept: "image/jpeg,image/png,image/webp",
            class: "sr-only",
            "data-file-upload-target": "input",
            "data-action": "change->file-upload#onChange" %>
      <label for="<%= f.field_id(:cover_art) %>"
             class="file-upload__zone"
             data-file-upload-target="zone">
        <strong>Click to browse</strong> or drag an image here
        <p class="file-upload__zone-hint">JPEG, PNG, or WebP &mdash; max 5MB</p>
      </label>
      <div class="file-upload__preview file-upload__preview--empty"
           data-file-upload-target="preview"></div>
    </div>
    <span class="form-hint">Optional. Displayed on the novel card.</span>
  </div>

  <%# --- Full-width: long-form fields --- %>
  <div class="form-group">
    <%= f.label :summary, class: "form-label" %>
    <%= f.text_area :summary, rows: 4, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :tone, class: "form-label" %>
    <%= f.text_area :tone, rows: 3, class: "form-input" %>
    <span class="form-hint">Describe the narrative voice and register.</span>
  </div>

  <div class="form-group">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_area :notes, rows: 3, class: "form-input" %>
  </div>

  <%# organization_id is required. On new, it defaults to the first org.
      When multi-org management is built, replace with a proper select. %>
  <% if novel.new_record? %>
    <%= f.hidden_field :organization_id,
          value: novel.organization_id || Organization.first&.id %>
  <% end %>

  <div class="form-actions">
    <%= f.submit "Save", class: "btn btn--primary" %>
    <%= link_to "Cancel", novel.persisted? ? novel_path(novel) : novels_path,
          class: "btn btn--ghost" %>
  </div>
<% end %>
