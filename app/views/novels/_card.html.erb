<%#
  app/views/novels/_card.html.erb

  Reusable novel card. Used on the dashboard and the novel index.
  Expects a `novel` local with preloaded chapters and translation_jobs.

  Displays: title, Korean title, series, chapter progress, pending jobs count.
  data-testid="novel-card" is used by system specs.
%>
<% translated_count = novel.chapters.count { |c| c.translated? || c.reviewed? } %>
<% total_chapters   = novel.chapters.size %>
<% pending_jobs     = novel.translation_jobs.count { |j| j.queued? || j.running? } %>

<article class="novel-card" data-testid="novel-card">
  <div class="novel-card__header">
    <%= link_to novel.title, novel, class: "novel-card__title" %>
    <% if novel.korean_title.present? %>
      <span class="novel-card__korean-title"><%= novel.korean_title %></span>
    <% end %>
  </div>

  <div class="novel-card__meta">
    <% if novel.series.present? %>
      <span class="novel-card__series"><%= novel.series.name %></span>
      <span class="novel-card__meta-sep" aria-hidden="true">·</span>
    <% end %>
    <% if novel.genre.present? %>
      <span class="novel-card__genre"><%= novel.genre %></span>
      <span class="novel-card__meta-sep" aria-hidden="true">·</span>
    <% end %>
    <span class="novel-card__visibility novel-card__visibility--<%= novel.visibility %>">
      <%= novel.visibility.capitalize %>
    </span>
  </div>

  <div class="novel-card__stats">
    <div class="novel-card__stat">
      <span class="novel-card__stat-value"><%= translated_count %></span>
      <span class="novel-card__stat-label"> / <%= total_chapters %> translated</span>
    </div>
    <% if pending_jobs > 0 %>
      <div class="novel-card__stat novel-card__stat--jobs">
        <span class="novel-card__stat-value"><%= pending_jobs %></span>
        <span class="novel-card__stat-label"> pending <%= "job".pluralize(pending_jobs) %></span>
      </div>
    <% end %>
  </div>
</article>
