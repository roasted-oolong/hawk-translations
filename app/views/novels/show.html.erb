<%# app/views/novels/show.html.erb %>
<% content_for :title, "#{@novel.title} — Hawk" %>

<%# Persistent subscription for the Review tab's "Preread Bible Entries"
    card — lives here, in the page shell, rather than inside
    chapter_review/tab.html.erb's swappable frame content, so it survives
    tab switches instead of resubscribing on every render. See
    TranslationJob#broadcast_preread_entries_status. %>
<%= turbo_stream_from "novel_#{@novel.id}_preread" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, nil]
    ] %>

<%# ================================================================== %>
<%# Header block                                                        %>
<%# ================================================================== %>
<div class="novel-show__header-block">

  <%# Cover art slot %>
  <div class="novel-show__cover-slot" data-testid="novel-show-cover">
    <% if @novel.cover_art.attached? && @novel.cover_art.blob.persisted? %>
      <%= image_tag @novel.cover_art,
            class: "novel-show__cover-img",
            alt:   "Cover art for #{@novel.title}" %>
    <% end %>
  </div>

  <%# Identity + actions %>
  <div class="novel-show__header-body">
    <div class="novel-show__header-top">
      <%# Genre badge %>
      <% if @novel.genre.present? %>
        <span class="novel-show__genre-badge" data-testid="novel-genre-badge">
          <%= @novel.genre %>
        </span>
      <% end %>

      <%# Edit + Remove actions %>
      <div class="btn-group novel-show__header-actions">
        <%= link_to "Edit", edit_novel_path(@novel), class: "btn btn--secondary btn--sm" %>
        <%= modal_button_to "Remove", @novel,
              method:        :delete,
              message:       "Remove \"#{@novel.title}\"? This cannot be undone.",
              confirm_label: "Remove" %>
      </div>
    </div>

    <%# Title %>
    <h1 class="page-title" data-testid="novel-title"><%= @novel.title %></h1>
    <% if @novel.korean_title.present? %>
      <p class="page-subtitle novel-show__korean-title"><%= @novel.korean_title %></p>
    <% end %>

    <%# Summary %>
    <% if @novel.summary.present? %>
      <p class="novel-show__summary"><%= @novel.summary %></p>
    <% end %>

    <%# Progress bar — reviewed / total %>
    <% total_chapters    = @chapters.size %>
    <% reviewed_count    = @chapters.count(&:reviewed?) %>
    <% progress_pct      = total_chapters > 0 ? (reviewed_count.to_f / total_chapters * 100).floor : 0 %>

    <div class="novel-show__progress">
      <div class="novel-show__progress-track"
           data-testid="novel-show-progress-track"
           role="progressbar"
           aria-valuenow="<%= progress_pct %>"
           aria-valuemin="0"
           aria-valuemax="100">
        <div class="novel-show__progress-fill"
             style="width: <%= progress_pct %>%;"></div>
      </div>
      <p class="novel-show__progress-label" data-testid="novel-show-progress-label">
        <%= reviewed_count %> / <%= total_chapters %> &middot; <%= progress_pct %>% reviewed
      </p>
    </div>
  </div>
</div>

<%# ================================================================== %>
<%# Tab strip + panels                                                  %>
<%# ================================================================== %>
<div class="novel-tabs"
     data-controller="tabs"
     data-tabs-novel-id-value="<%= @novel.id %>"
     data-testid="novel-tabs">

  <%# Tab buttons %>
  <div class="novel-tabs__strip" role="tablist">

    <button class="novel-tab"
            role="tab"
            data-action="click->tabs#select"
            data-tabs-key-param="chapters"
            data-testid="tab-chapters"
            aria-controls="tab-panel-chapters"
            aria-selected="false">
      Chapters
    </button>

    <button class="novel-tab"
            role="tab"
            data-action="click->tabs#select"
            data-tabs-key-param="bible"
            data-testid="tab-bible"
            aria-controls="tab-panel-bible"
            aria-selected="false">
      Bible
    </button>

    <button class="novel-tab"
            role="tab"
            data-action="click->tabs#select"
            data-tabs-key-param="review"
            data-testid="tab-review"
            aria-controls="tab-panel-review"
            aria-selected="false">
      Review
    </button>

    <button class="novel-tab"
            role="tab"
            data-action="click->tabs#select"
            data-tabs-key-param="voice-calibration"
            data-testid="tab-voice-calibration"
            aria-controls="tab-panel-voice-calibration"
            aria-selected="false">
      Voice Calibration
    </button>

  </div><%# /.novel-tabs__strip %>

  <%# Tab panels — Turbo Frames; src set eagerly by tabs_controller on connect %>

  <turbo-frame id="tab-panel-chapters"
               data-tabs-src-value="<%= novel_chapters_path(@novel) %>"
               data-testid="tab-panel-chapters"
               role="tabpanel"
               aria-labelledby="tab-chapters">
    <%# src set by tabs_controller on connect(); content loads immediately. %>
  </turbo-frame>

  <turbo-frame id="tab-panel-bible"
               data-tabs-src-value="<%= novel_bible_path(@novel) %>"
               data-testid="tab-panel-bible"
               role="tabpanel"
               aria-labelledby="tab-bible">
    <%# src set by tabs_controller on connect(); content loads immediately. %>
  </turbo-frame>

  <turbo-frame id="tab-panel-review"
               data-tabs-src-value="<%= novel_chapter_review_tab_path(@novel) %>"
               data-testid="tab-panel-review"
               role="tabpanel"
               aria-labelledby="tab-review">
    <%# src set by tabs_controller on connect(); content loads immediately. %>
  </turbo-frame>

  <turbo-frame id="tab-panel-voice-calibration"
               data-tabs-src-value="<%= novel_voice_calibration_tab_path(@novel) %>"
               data-testid="tab-panel-voice-calibration"
               role="tabpanel"
               aria-labelledby="tab-voice-calibration">
    <%# src set by tabs_controller on connect(); content loads immediately. %>
  </turbo-frame>

</div><%# /.novel-tabs %>
