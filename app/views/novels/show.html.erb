<%# app/views/novels/show.html.erb %>
<% content_for :title, "#{@novel.title} — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, nil]
    ] %>

<div class="page-header">
  <div class="page-header__row">
    <div>
      <h1 class="page-title" data-testid="novel-title"><%= @novel.title %></h1>
      <% if @novel.korean_title.present? %>
        <p class="page-subtitle novel-show__korean-title"><%= @novel.korean_title %></p>
      <% end %>
    </div>
    <div class="btn-group">
      <%= link_to "Edit", edit_novel_path(@novel), class: "btn btn--secondary btn--sm" %>
      <%= modal_button_to "Remove", @novel,
            method:        :delete,
            message:       "Remove \"#{@novel.title}\"? This cannot be undone.",
            confirm_label: "Remove" %>
    </div>
  </div>

  <div class="novel-show__meta">
    <% if @novel.series.present? %>
      <span class="novel-show__meta-item">
        <span class="novel-show__meta-label">Series</span>
        <span class="novel-show__meta-value"><%= @novel.series.name %></span>
      </span>
    <% end %>
    <% if @novel.genre.present? %>
      <span class="novel-show__meta-item">
        <span class="novel-show__meta-label">Genre</span>
        <span class="novel-show__meta-value"><%= @novel.genre %></span>
      </span>
    <% end %>
    <span class="novel-show__meta-item">
      <span class="novel-show__meta-label">Visibility</span>
      <span class="novel-show__meta-value"><%= @novel.visibility.capitalize %></span>
    </span>
  </div>

  <% if @novel.summary.present? %>
    <p class="novel-show__summary"><%= @novel.summary %></p>
  <% end %>
</div>

<%# ------------------------------------------------------------------ %>
<%# Chapter summary                                                     %>
<%# ------------------------------------------------------------------ %>
<section class="novel-show__section" aria-labelledby="chapters-heading" data-testid="novel-chapters-summary">
  <div class="novel-show__section-header">
    <h2 class="novel-show__section-title" id="chapters-heading">
      Chapters (<%= @chapters.size %>)
    </h2>
    <%= link_to "Upload Chapter(s)", new_novel_chapter_path(@novel), class: "btn btn--primary btn--sm" %>
  </div>

  <% if @chapters.none? %>
    <p class="empty-state__message">No chapters yet.</p>
  <% else %>
    <% untranslated_count = @chapters.count(&:untranslated?) %>
    <% translated_count   = @chapters.count(&:translated?) %>
    <% reviewed_count     = @chapters.count(&:reviewed?) %>

    <div class="chapter-status-summary">
      <div class="chapter-status-summary__item">
        <span class="chapter-status-summary__count"><%= untranslated_count %></span>
        <span class="chapter-status-summary__label">untranslated</span>
      </div>
      <div class="chapter-status-summary__item">
        <span class="chapter-status-summary__count"><%= translated_count %></span>
        <span class="chapter-status-summary__label">translated</span>
      </div>
      <div class="chapter-status-summary__item">
        <span class="chapter-status-summary__count"><%= reviewed_count %></span>
        <span class="chapter-status-summary__label">reviewed</span>
      </div>
    </div>

    <p class="novel-show__chapters-link">
      <%= link_to "View all #{@chapters.size} chapters \u2192", novel_chapters_path(@novel) %>
    </p>
  <% end %>
</section>

<hr class="divider">

<%# ------------------------------------------------------------------ %>
<%# Bible — link to landing page                                        %>
<%# ------------------------------------------------------------------ %>
<section class="novel-show__section" aria-labelledby="bible-heading" data-testid="novel-bible-summary">
  <div class="novel-show__section-header">
    <h2 class="novel-show__section-title" id="bible-heading">Translation Bible</h2>
    <%= link_to "Translation Bible \u2192", novel_bible_path(@novel), class: "btn btn--secondary btn--sm" %>
  </div>
  <p class="novel-show__bible-hint">Characters, locations, terminology, cultural phrases, and story entries.</p>
</section>

<hr class="divider">

<%# ------------------------------------------------------------------ %>
<%# Jobs link                                                           %>
<%# ------------------------------------------------------------------ %>
<section class="novel-show__section" aria-labelledby="jobs-heading">
  <div class="novel-show__section-header">
    <h2 class="novel-show__section-title" id="jobs-heading">Translation Jobs</h2>
    <%= link_to "Translation Jobs", novel_translation_jobs_path(@novel), class: "btn btn--secondary btn--sm" %>
  </div>
</section>
