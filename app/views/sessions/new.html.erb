<%# Login page — standalone, no nav bar.
  The application layout suppresses the nav when unauthenticated.
%>
<div class="login-page">
  <div class="login-card">

    <%# Logo / brand mark %>
    <div class="login-card__logo">
      <span class="login-card__glyph" aria-hidden="true">鷹</span>
      <h1 class="login-card__app-name">Hawk Translations</h1>
      <p class="login-card__tagline">Korean-to-English novel translation</p>
    </div>

    <%# Flash alert (e.g. OAuth failure) — rendered inline on the login page
        because the layout flash sits above the nav offset, which doesn't
        apply here. The layout flash is also rendered, but this catches
        cases where the user lands directly on /login with an alert. %>
    <% if alert %>
      <div class="flash-message flash-message--alert"
           data-testid="flash-alert"
           role="alert"
           style="width: 100%; border-radius: var(--radius-md);">
        <span class="flash-message__text"><%= alert %></span>
      </div>
    <% end %>

    <%# Sign-in actions %>
    <div class="login-card__actions">
      <%= button_to "/auth/google_oauth2",
            method: :post,
            class: "btn btn--secondary btn--google",
            form: { data: { turbo: false } } do %>
        <%= render "components/icon", name: "google", size: 18 %>
        <span>Sign in with Google</span>
      <% end %>
    </div>

  </div>
</div>
