<%# app/views/translation_jobs/show.html.erb
#
# Translation job detail page.
#
# Status polling:
#   When a job is active (queued or running), the job-status turbo-frame is
#   wrapped in a div with data-controller="poll". The poll_controller calls
#   frame.reload() every 3 seconds, re-fetching this page and swapping only
#   the matching turbo-frame content.
#
#   When the job reaches a terminal state (completed or failed), the server
#   renders the frame WITHOUT the poll wrapper, so the controller is never
#   mounted and polling does not start. No cleanup needed.
%>
<% content_for :title, "#{@translation_job.job_type.humanize} Job — #{@novel.title} — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Translation Jobs", novel_translation_jobs_path(@novel)],
      [@translation_job.job_type.humanize, nil]
    ] %>

<div class="page-header" data-testid="job-detail">
  <div class="page-header__row">
    <h1 class="page-title"><%= @translation_job.job_type.humanize %></h1>
    <% if @translation_job.cancellable? %>
      <%= modal_button_to "Cancel job", novel_translation_job_path(@novel, @translation_job),
            method:        :delete,
            message:       "Cancel this queued job? It cannot be restarted.",
            confirm_label: "Cancel job" %>
    <% end %>
  </div>
</div>

<%# ------------------------------------------------------------------ %>
<%# Poll wrapper — only rendered when job is active                    %>
<%# ------------------------------------------------------------------ %>
<% if @translation_job.queued? || @translation_job.running? %>
  <div data-controller="poll" data-poll-interval-value="3000">
<% end %>

<%= turbo_frame_tag "job-status" do %>

  <div class="card job-detail__card">
    <dl class="job-detail__meta">
      <div class="job-detail__meta-row">
        <dt class="job-detail__meta-label">Novel</dt>
        <dd class="job-detail__meta-value">
          <%= link_to @novel.title, @novel, class: "data-table__link" %>
        </dd>
      </div>
      <div class="job-detail__meta-row">
        <dt class="job-detail__meta-label">Job type</dt>
        <dd class="job-detail__meta-value"><%= @translation_job.job_type.humanize %></dd>
      </div>
      <div class="job-detail__meta-row">
        <dt class="job-detail__meta-label">Chapters</dt>
        <dd class="job-detail__meta-value">
          <%= @translation_job.chapter_range_label || %(<span class="text-muted">—</span>).html_safe %>
        </dd>
      </div>
      <div class="job-detail__meta-row">
        <dt class="job-detail__meta-label">Status</dt>
        <dd class="job-detail__meta-value">
          <%= render "components/status_badge", status: @translation_job.status %>
        </dd>
      </div>
      <div class="job-detail__meta-row">
        <dt class="job-detail__meta-label">Triggered by</dt>
        <dd class="job-detail__meta-value"><%= @translation_job.user.name %></dd>
      </div>
      <div class="job-detail__meta-row">
        <dt class="job-detail__meta-label">Triggered at</dt>
        <dd class="job-detail__meta-value">
          <%= @translation_job.created_at.strftime("%b %-d, %Y %H:%M") %>
        </dd>
      </div>
      <% if @translation_job.updated_at != @translation_job.created_at %>
        <div class="job-detail__meta-row">
          <dt class="job-detail__meta-label">Last updated</dt>
          <dd class="job-detail__meta-value">
            <%= @translation_job.updated_at.strftime("%b %-d, %Y %H:%M") %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# ---------------------------------------------------------------- %>
  <%# Output / result section                                           %>
  <%# ---------------------------------------------------------------- %>
  <% if @translation_job.result_payload.present? %>
    <div class="card job-detail__output" data-testid="job-output">
      <h2 class="job-detail__output-title">Output</h2>
      <pre class="job-detail__output-pre"><%= @translation_job.result_payload %></pre>
    </div>
  <% elsif @translation_job.queued? || @translation_job.running? %>
    <div class="job-detail__pending" data-testid="job-pending-message">
      <p class="job-detail__pending-text">
        Job is <strong><%= @translation_job.status %></strong> — output will appear here when complete.
      </p>
    </div>
  <% end %>

<% end %>

<% if @translation_job.queued? || @translation_job.running? %>
  </div>
<% end %>
