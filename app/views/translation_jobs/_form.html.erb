<%# app/views/translation_jobs/_form.html.erb
#
# Trigger form for a new translation job.
# Used on translation_jobs/index.
#
# Locals: novel, translation_job
%>
<%= form_with model: [ novel, translation_job ],
      data: { "testid": "job-trigger-form-inner" } do |f| %>
  <% if translation_job.errors.any? %>
    <div class="form-errors">
      <p class="form-errors__summary">
        <%= pluralize(translation_job.errors.count, "error") %> prevented this job from being triggered:
      </p>
      <ul class="form-errors__list">
        <% translation_job.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="jobs-trigger__fields">
    <div class="form-group">
      <%= f.label :job_type, "Job type", class: "form-label" %>
      <%# Bible build and post-translation review are sunset from this form —
          see docs/DECISIONS.md's 2026-07-30 entry. Job type, model, and specs
          are untouched; this is a UI-only trigger removal. %>
      <%= f.select :job_type,
            [
              [ "Preread",         "preread" ],
              [ "Translate batch", "translate_batch" ]
            ],
            { include_blank: "— Select job type —" },
            class: "form-select" %>
    </div>

    <div class="form-group">
      <%= f.label :chapter_start, "Chapter start", class: "form-label" %>
      <%= f.number_field :chapter_start,
            min: 1,
            placeholder: "e.g. 1",
            class: "form-input" %>
      <span class="form-hint">First chapter to include in this run.</span>
    </div>

    <div class="form-group">
      <%= f.label :chapter_end, "Chapter end", class: "form-label" %>
      <%= f.number_field :chapter_end,
            min: 1,
            placeholder: "e.g. 10",
            class: "form-input" %>
      <span class="form-hint">Set equal to chapter start for single-chapter jobs.</span>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit "Trigger job", class: "btn btn--primary" %>
  </div>
<% end %>
