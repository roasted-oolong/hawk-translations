<%# app/views/rendering_rules/_form.html.erb
    Used by new.html.erb only — a pure novel-specific addition (a rule_key
    with no default counterpart). Overriding an existing default happens
    inline on the index page instead (see _rule_card.html.erb). %>
<%= form_with model: @rule, url: novel_rendering_rules_path(@novel), method: :post,
      data: { testid: "rendering-rule-form" } do |f| %>
  <% if @rule.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p class="form-errors__summary"><%= pluralize(@rule.errors.count, "error") %> prevented this from saving:</p>
      <ul class="form-errors__list">
        <% @rule.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bible-form__grid">
    <div class="form-group">
      <%= f.label :rule_key, "Rule key", class: "form-label" %>
      <%= f.text_field :rule_key, class: "form-input", placeholder: "e.g. em-dash" %>
      <p class="form-hint">A short, stable identifier — used internally to track this rule, not shown in the guide.</p>
    </div>

    <div class="form-group">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :guidance, class: "form-label" %>
    <%= f.text_area :guidance, rows: 5, class: "form-input" %>
  </div>

  <div class="bible-form__grid">
    <div class="form-group">
      <%= f.label :example_input, "Example input (Korean)", class: "form-label" %>
      <%= f.text_area :example_input, rows: 3, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :example_output, "Example output (English)", class: "form-label" %>
      <%= f.text_area :example_output, rows: 3, class: "form-input" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :position, class: "form-label" %>
    <%= f.number_field :position, class: "form-input" %>
  </div>

  <div class="form-actions">
    <%= f.submit "Save", class: "btn btn--primary" %>
    <%= link_to "Cancel", novel_rendering_rules_path(@novel), class: "btn btn--ghost" %>
  </div>
<% end %>
