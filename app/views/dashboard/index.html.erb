<%# app/views/dashboard/index.html.erb %>
<% content_for :title, "Dashboard — Hawk" %>

<div class="page-header">
  <h1 class="page-title" data-testid="dashboard-heading">Dashboard</h1>
  <p class="page-subtitle">Your translation workspace.</p>
</div>

<% if @active_jobs.any? %>
  <div data-controller="poll" data-poll-interval-value="1000">
<% end %>

<%= turbo_frame_tag "dashboard-active-jobs" do %>
  <%= render "novels/active_jobs", active_jobs: @active_jobs, show_novel: true %>
<% end %>

<% if @active_jobs.any? %>
  </div>
<% end %>

<section class="dashboard-section" aria-labelledby="assigned-novels-heading">
  <div class="dashboard-section__header">
    <h2 class="dashboard-section__title" id="assigned-novels-heading">My Novels</h2>
    <%= link_to "Browse all novels →", novels_path, class: "dashboard-section__link" %>
  </div>

  <% if @novels.none? %>
    <div class="empty-state" data-testid="dashboard-empty">
      <p class="empty-state__message">You have no novels assigned yet.</p>
      <p class="empty-state__hint">Ask your Org Admin to assign a novel to your team.</p>
    </div>
  <% else %>
    <div class="novel-grid">
      <% @novels.each do |novel| %>
        <%= render "novels/card", novel: novel %>
      <% end %>
    </div>
  <% end %>
</section>
