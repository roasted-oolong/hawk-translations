<h1><%= @entry.term %></h1>
<% if @entry.korean_term.present? %>
  <p><em><%= @entry.korean_term %></em></p>
<% end %>

<p>
  <%= link_to "← All Terminology", novel_bible_terminologies_path(@novel) %> |
  <%= link_to "Edit", edit_novel_bible_terminology_path(@novel, @entry) %> |
  <%= button_to "Remove", novel_bible_terminology_path(@novel, @entry), method: :delete,
      data: { turbo_confirm: "Remove \"#{@entry.term}\"?" } %>
</p>

<hr>

<% if @entry.first_appearance_chapter.present? %>
  <p><strong>First Appearance:</strong> Chapter <%= @entry.first_appearance_chapter %></p>
<% end %>

<% if @entry.definition.present? %>
  <h2>Definition</h2>
  <p><%= simple_format @entry.definition %></p>
<% end %>

<% if @entry.usage_notes.present? %>
  <h2>Usage Notes</h2>
  <p><%= simple_format @entry.usage_notes %></p>
<% end %>

<% if @entry.notes.present? %>
  <h2>Notes</h2>
  <p><%= simple_format @entry.notes %></p>
<% end %>

<p class="muted">Last updated: <%= @entry.last_updated_at&.strftime("%B %-d, %Y") || "—" %></p>
