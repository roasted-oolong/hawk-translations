<%# app/views/bible_terminologies/show.html.erb %>
<% content_for :title, "#{@entry.term} — Terminology — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Bible", novel_bible_path(@novel)],
      ["Terminology", novel_bible_terminologies_path(@novel)],
      [@entry.term, nil]
    ] %>

<div class="page-header">
  <div class="page-header__row">
    <div>
      <h1 class="page-title" data-testid="entry-title"><%= @entry.term %></h1>
      <% if @entry.korean_term.present? %>
        <p class="page-subtitle bible-entry__korean"><%= @entry.korean_term %></p>
      <% end %>
    </div>
    <div class="btn-group">
      <%= link_to "Edit", edit_novel_bible_terminology_path(@novel, @entry), class: "btn btn--secondary btn--sm" %>
      <%= modal_button_to "Remove", novel_bible_terminology_path(@novel, @entry),
            method:        :delete,
            message:       "Remove \"#{@entry.term}\"?",
            confirm_label: "Remove" %>
    </div>
  </div>
</div>

<div class="card bible-entry">
  <div class="bible-entry__meta">
    <% if @entry.first_appearance_chapter.present? %>
      <div class="bible-entry__meta-item">
        <span class="bible-entry__meta-label">First appears</span>
        <span class="bible-entry__meta-value">Ch. <%= @entry.first_appearance_chapter %></span>
      </div>
    <% end %>
  </div>

  <% if @entry.definition.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Definition</h2>
      <div class="bible-entry__body"><%= simple_format @entry.definition %></div>
    </div>
  <% end %>

  <% if @entry.usage_notes.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Usage Notes</h2>
      <div class="bible-entry__body"><%= simple_format @entry.usage_notes %></div>
    </div>
  <% end %>

  <% if @entry.notes.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Notes</h2>
      <div class="bible-entry__body"><%= simple_format @entry.notes %></div>
    </div>
  <% end %>

  <p class="bible-entry__updated-at">Last updated: <%= @entry.last_updated_at&.strftime("%B %-d, %Y") || "—" %></p>
</div>
