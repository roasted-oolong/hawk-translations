<%= form_with model: [ @novel, @entry ] do |f| %>
  <% if @entry.errors.any? %>
    <div>
      <p><strong><%= pluralize(@entry.errors.count, "error") %> prevented this from saving:</strong></p>
      <ul>
        <% @entry.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :term %>
    <%= f.text_field :term %>
  </div>

  <div>
    <%= f.label :korean_term, "Korean Term" %>
    <%= f.text_field :korean_term %>
  </div>

  <div>
    <%= f.label :first_appearance_chapter, "First Appearance (Chapter #)" %>
    <%= f.number_field :first_appearance_chapter, min: 1 %>
  </div>

  <div>
    <%= f.label :definition %>
    <%= f.text_area :definition, rows: 4 %>
  </div>

  <div>
    <%= f.label :usage_notes, "Usage Notes" %>
    <%= f.text_area :usage_notes, rows: 4 %>
  </div>

  <div>
    <%= f.label :notes %>
    <%= f.text_area :notes, rows: 4 %>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
