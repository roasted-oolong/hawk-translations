<%# app/views/bible_terminologies/_form.html.erb %>
<%= form_with model: [ @novel, @entry ], data: { testid: "bible-entry-form" } do |f| %>
  <% if @entry.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p class="form-errors__summary"><%= pluralize(@entry.errors.count, "error") %> prevented this from saving:</p>
      <ul class="form-errors__list">
        <% @entry.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bible-form__grid">
    <div class="form-group">
      <%= f.label :term, class: "form-label" %>
      <%= f.text_field :term, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :korean_term, "Korean Term", class: "form-label" %>
      <%= f.text_field :korean_term, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :first_appearance_chapter, "First Appearance (Chapter #)", class: "form-label" %>
      <%= f.number_field :first_appearance_chapter, min: 1, class: "form-input" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :definition, class: "form-label" %>
    <%= f.text_area :definition, rows: 4, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :usage_notes, "Usage Notes", class: "form-label" %>
    <%= f.text_area :usage_notes, rows: 4, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_area :notes, rows: 4, class: "form-input" %>
  </div>

  <div class="form-actions">
    <%= f.submit "Save", class: "btn btn--primary" %>
    <%= link_to "Cancel", novel_bible_terminologies_path(@novel), class: "btn btn--ghost" %>
  </div>
<% end %>
