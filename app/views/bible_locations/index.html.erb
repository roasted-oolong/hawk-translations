<%# app/views/bible_locations/index.html.erb %>
<% content_for :title, "Locations — #{@novel.title} — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Bible", novel_bible_path(@novel)],
      ["Locations", nil]
    ] %>

<div class="page-header">
  <div class="page-header__row">
    <h1 class="page-title">Locations</h1>
    <%= link_to "Add Location", new_novel_bible_location_path(@novel), class: "btn btn--primary btn--sm" %>
  </div>
</div>

<% if @entries.none? %>
  <div class="empty-state" data-testid="locations-empty">
    <p class="empty-state__message">No locations yet.</p>
    <%= link_to "Add the first location \u2192", new_novel_bible_location_path(@novel) %>
  </div>
<% else %>
  <div class="data-table-wrapper">
    <table class="data-table" data-testid="locations-table">
      <thead>
        <tr>
          <th class="data-table__th">Name</th>
          <th class="data-table__th">Korean Name</th>
          <th class="data-table__th">Type</th>
          <th class="data-table__th">First Appears</th>
          <th class="data-table__th data-table__th--actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr class="data-table__row">
            <td class="data-table__td data-table__td--title">
              <%= link_to entry.name, novel_bible_location_path(@novel, entry), class: "data-table__link" %>
            </td>
            <td class="data-table__td bible-td--korean"><%= entry.korean_name.presence || "—" %></td>
            <td class="data-table__td"><%= entry.location_type.presence || "—" %></td>
            <td class="data-table__td"><%= entry.first_appearance_chapter ? "Ch. #{entry.first_appearance_chapter}" : "—" %></td>
            <td class="data-table__td data-table__td--actions">
              <%= link_to "Edit", edit_novel_bible_location_path(@novel, entry), class: "btn btn--ghost btn--sm" %>
              <%= modal_button_to "Remove", novel_bible_location_path(@novel, entry),
                    method:        :delete,
                    message:       "Remove #{entry.name}?",
                    confirm_label: "Remove",
                    button_class:  "btn btn--danger btn--sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
