<%#
  Icon component — renders an inline SVG icon from the Heroicons set (outline style).

  Usage:
    render "components/icon", name: "x-mark"
    render "components/icon", name: "arrow-right-start-on-rectangle", size: 20, css_class: "icon--muted"

  Params:
    name      (String)  — icon identifier (see supported list below)
    size      (Integer) — width/height in px, default 16
    css_class (String)  — extra CSS classes appended to the <svg>

  Supported names (add as needed per milestone):
    "x-mark"                          — close / dismiss
    "arrow-right-start-on-rectangle"  — sign out
    "google"                          — Google logo (for sign-in button)

  All paths sourced from Heroicons 2.x (MIT) and the Google Brand SVG.
  Heroicons: https://heroicons.com
%>

<%
  icon_name  = local_assigns.fetch(:name)
  icon_size  = local_assigns.fetch(:size, 16)
  extra_class = local_assigns.fetch(:css_class, nil)
  svg_class  = ["icon", extra_class].compact.join(" ")
%>

<% case icon_name %>
<% when "x-mark" %>
  <svg class="<%= svg_class %>" xmlns="http://www.w3.org/2000/svg"
       width="<%= icon_size %>" height="<%= icon_size %>"
       viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round"
       aria-hidden="true" focusable="false">
    <path d="M18 6 6 18M6 6l12 12"/>
  </svg>

<% when "arrow-right-start-on-rectangle" %>
  <svg class="<%= svg_class %>" xmlns="http://www.w3.org/2000/svg"
       width="<%= icon_size %>" height="<%= icon_size %>"
       viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="1.5"
       stroke-linecap="round" stroke-linejoin="round"
       aria-hidden="true" focusable="false">
    <path d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15"/>
    <path d="M18 15l3-3m0 0-3-3m3 3H9"/>
  </svg>

<% when "google" %>
  <%# Google G logo — brand SVG (used on sign-in button only) %>
  <svg class="<%= svg_class %>" xmlns="http://www.w3.org/2000/svg"
       width="<%= icon_size %>" height="<%= icon_size %>"
       viewBox="0 0 24 24"
       aria-hidden="true" focusable="false">
    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
  </svg>

<% else %>
  <%# Unknown icon — render nothing rather than break the page %>
<% end %>
