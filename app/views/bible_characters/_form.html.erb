<%# app/views/bible_characters/_form.html.erb %>
<%= form_with model: [ @novel, @entry ], data: { testid: "bible-entry-form" } do |f| %>
  <% if @entry.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p class="form-errors__summary"><%= pluralize(@entry.errors.count, "error") %> prevented this from saving:</p>
      <ul class="form-errors__list">
        <% @entry.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bible-form__grid">
    <div class="form-group">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :korean_name, "Korean Name", class: "form-label" %>
      <%= f.text_field :korean_name, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :role, class: "form-label" %>
      <%= f.text_field :role, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :significance, class: "form-label" %>
      <%= f.text_field :significance, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :first_appearance_chapter, "First Appearance (Chapter #)", class: "form-label" %>
      <%= f.number_field :first_appearance_chapter, min: 1, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :aliases, class: "form-label" %>
      <%= f.text_area :aliases, rows: 2, class: "form-input" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :physical_description, "Physical Description", class: "form-label" %>
    <%= f.text_area :physical_description, rows: 4, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :speech_pattern, "Speech Pattern", class: "form-label" %>
    <%= f.text_area :speech_pattern, rows: 4, class: "form-input" %>
  </div>

  <div class="bible-form__grid">
    <div class="form-group">
      <%= f.label :honorifics_used_toward, "Honorifics Used Toward Them", class: "form-label" %>
      <%= f.text_area :honorifics_used_toward, rows: 2, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :honorifics_they_use, "Honorifics They Use", class: "form-label" %>
      <%= f.text_area :honorifics_they_use, rows: 2, class: "form-input" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :relationships, class: "form-label" %>
    <%= f.text_area :relationships, rows: 4, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_area :notes, rows: 4, class: "form-input" %>
  </div>

  <div class="form-actions">
    <%= f.submit "Save", class: "btn btn--primary" %>
    <%= link_to "Cancel", novel_bible_characters_path(@novel), class: "btn btn--ghost" %>
  </div>
<% end %>
