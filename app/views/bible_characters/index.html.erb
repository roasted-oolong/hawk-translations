<%# app/views/bible_characters/index.html.erb %>
<% content_for :title, "Characters — #{@novel.title} — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Bible", novel_bible_path(@novel)],
      ["Characters", nil]
    ] %>

<div class="page-header">
  <div class="page-header__row">
    <h1 class="page-title">Characters</h1>
    <%= link_to "Add Character", new_novel_bible_character_path(@novel), class: "btn btn--primary btn--sm" %>
  </div>
</div>

<div data-controller="bible-tabs">
  <div class="bible-tabs__bar">
    <button class="bible-tabs__btn bible-tabs__btn--active" type="button"
            data-bible-tabs-target="btn"
            data-action="click->bible-tabs#show"
            data-bible-tabs-panel-param="main">
      Characters
    </button>
    <button class="bible-tabs__btn" type="button"
            data-bible-tabs-target="btn"
            data-action="click->bible-tabs#show"
            data-bible-tabs-panel-param="pending">
      Pending suggestions
      <% if @pending_preread_entries.any? %>
        <span class="bible-tabs__count"><%= @pending_preread_entries.size %></span>
      <% end %>
    </button>
    <button class="bible-tabs__btn" type="button"
            data-bible-tabs-target="btn"
            data-action="click->bible-tabs#show"
            data-bible-tabs-panel-param="dismissed">
      Dismissed preread
      <% if @dismissed_preread_entries.any? %>
        <span class="bible-tabs__count"><%= @dismissed_preread_entries.size %></span>
      <% end %>
    </button>
  </div>

  <div data-bible-tabs-target="panel" data-bible-tabs-panel="main">
    <% if @entries.none? %>
      <div class="empty-state" data-testid="characters-empty">
        <p class="empty-state__message">No characters yet.</p>
        <%= link_to "Add the first character →", new_novel_bible_character_path(@novel) %>
      </div>
    <% else %>
      <div class="data-table-wrapper">
        <table class="data-table" data-testid="characters-table">
          <thead>
            <tr>
              <th class="data-table__th">Name</th>
              <th class="data-table__th">Korean Name</th>
              <th class="data-table__th">Role</th>
              <th class="data-table__th">First Appears</th>
              <th class="data-table__th data-table__th--actions"></th>
            </tr>
          </thead>
          <tbody>
            <% @entries.each do |entry| %>
              <tr class="data-table__row">
                <td class="data-table__td data-table__td--title">
                  <%= link_to entry.name, novel_bible_character_path(@novel, entry), class: "data-table__link" %>
                </td>
                <td class="data-table__td bible-td--korean"><%= entry.korean_name.presence || "—" %></td>
                <td class="data-table__td"><%= entry.role.presence || "—" %></td>
                <td class="data-table__td"><%= entry.first_appearance_chapter ? "Ch. #{entry.first_appearance_chapter}" : "—" %></td>
                <td class="data-table__td data-table__td--actions">
                  <%= link_to "Edit", edit_novel_bible_character_path(@novel, entry), class: "btn btn--ghost btn--sm" %>
                  <%= modal_button_to "Remove", novel_bible_character_path(@novel, entry),
                        method:        :delete,
                        message:       "Remove #{entry.name}?",
                        confirm_label: "Remove",
                        button_class:  "btn btn--danger btn--sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div data-bible-tabs-target="panel" data-bible-tabs-panel="pending" hidden>
    <% if @pending_preread_entries.any? %>
      <%= render "components/preread_pending_entries",
            entries: @pending_preread_entries, novel: @novel, category: :characters %>
    <% else %>
      <div class="empty-state" data-testid="pending-empty">
        <p class="empty-state__message">No pending preread suggestions.</p>
      </div>
    <% end %>
  </div>

  <div data-bible-tabs-target="panel" data-bible-tabs-panel="dismissed" hidden>
    <% if @dismissed_preread_entries.any? %>
      <%= render "components/preread_dismissed_entries",
            entries: @dismissed_preread_entries, novel: @novel, category: :characters %>
    <% else %>
      <div class="empty-state" data-testid="dismissed-empty">
        <p class="empty-state__message">No dismissed preread entries.</p>
      </div>
    <% end %>
  </div>
</div>
