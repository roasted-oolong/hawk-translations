<%# app/views/bible_characters/show.html.erb %>
<% content_for :title, "#{@entry.name} — Characters — Hawk" %>

<%= render "layouts/breadcrumb", crumbs: [
      ["Novels", novels_path],
      [@novel.title, novel_path(@novel)],
      ["Bible", novel_bible_path(@novel)],
      ["Characters", novel_bible_characters_path(@novel)],
      [@entry.name, nil]
    ] %>

<div class="page-header">
  <div class="page-header__row">
    <div>
      <h1 class="page-title" data-testid="entry-title"><%= @entry.name %></h1>
      <% if @entry.korean_name.present? %>
        <p class="page-subtitle bible-entry__korean"><%= @entry.korean_name %></p>
      <% end %>
    </div>
    <div class="btn-group">
      <%= link_to "Edit", edit_novel_bible_character_path(@novel, @entry), class: "btn btn--secondary btn--sm" %>
      <%= modal_button_to "Remove", novel_bible_character_path(@novel, @entry),
            method:        :delete,
            message:       "Remove #{@entry.name}?",
            confirm_label: "Remove" %>
    </div>
  </div>
</div>

<div class="card bible-entry">
  <div class="bible-entry__meta">
    <% if @entry.role.present? %>
      <div class="bible-entry__meta-item">
        <span class="bible-entry__meta-label">Role</span>
        <span class="bible-entry__meta-value"><%= @entry.role %></span>
      </div>
    <% end %>
    <% if @entry.significance.present? %>
      <div class="bible-entry__meta-item">
        <span class="bible-entry__meta-label">Significance</span>
        <span class="bible-entry__meta-value"><%= @entry.significance %></span>
      </div>
    <% end %>
    <% if @entry.first_appearance_chapter.present? %>
      <div class="bible-entry__meta-item">
        <span class="bible-entry__meta-label">First appears</span>
        <span class="bible-entry__meta-value">Ch. <%= @entry.first_appearance_chapter %></span>
      </div>
    <% end %>
    <% if @entry.aliases.present? %>
      <div class="bible-entry__meta-item">
        <span class="bible-entry__meta-label">Aliases</span>
        <span class="bible-entry__meta-value"><%= @entry.aliases %></span>
      </div>
    <% end %>
  </div>

  <% if @entry.physical_description.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Physical Description</h2>
      <div class="bible-entry__body"><%= simple_format @entry.physical_description %></div>
    </div>
  <% end %>

  <% if @entry.speech_pattern.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Speech Pattern</h2>
      <div class="bible-entry__body"><%= simple_format @entry.speech_pattern %></div>
    </div>
  <% end %>

  <% if @entry.honorifics_used_toward.present? || @entry.honorifics_they_use.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Honorifics</h2>
      <% if @entry.honorifics_used_toward.present? %>
        <div class="bible-entry__meta-item">
          <span class="bible-entry__meta-label">Used toward them</span>
          <span class="bible-entry__meta-value"><%= @entry.honorifics_used_toward %></span>
        </div>
      <% end %>
      <% if @entry.honorifics_they_use.present? %>
        <div class="bible-entry__meta-item">
          <span class="bible-entry__meta-label">They use</span>
          <span class="bible-entry__meta-value"><%= @entry.honorifics_they_use %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @entry.relationships.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Relationships</h2>
      <div class="bible-entry__body"><%= simple_format @entry.relationships %></div>
    </div>
  <% end %>

  <% if @entry.notes.present? %>
    <div class="bible-entry__section">
      <h2 class="bible-entry__section-title">Notes</h2>
      <div class="bible-entry__body"><%= simple_format @entry.notes %></div>
    </div>
  <% end %>

  <p class="bible-entry__updated-at">Last updated: <%= @entry.last_updated_at&.strftime("%B %-d, %Y") || "—" %></p>
</div>
