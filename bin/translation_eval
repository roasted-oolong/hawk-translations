#!/usr/bin/env ruby
# ---------------------------------------------------------------------------
# bin/translation_eval
#
# Offline prototype harness for the translation quality pipeline idea in
# docs/ROADMAP.md — CLI wrapper around Pipeline::Ruby::TranslationEval. Runs
# the 5-step pipeline (docs/DECISIONS.md's 2026-08-01 "5-step pipeline
# replaces 3-call pipeline" entry, updated by the 2026-08-02 hybrid beat
# segmentation entry) over a handful of chapters, writing all outputs to disk
# for manual review.
#
# The 5-step pipeline chains strictly, each step gated on the previous one
# producing valid, fully-covered output:
#   1. segmentation  — splits the chapter into passages (sequential
#      passage_id, anchor_quote concatenation reconstructs the source).
#   2. analysis      — Korean-only literary analysis per passage.
#   3. localization  — writes the English translation (no self-grading);
#      reassembled into localized_chapter.txt for direct review.
#   4. factcheck     — independently checks names/facts/cultural cues.
#   5. editor        — independently reviews ONLY the English text (no
#      Korean, no analysis) for prose quality.
# factcheck and editor both depend only on localization succeeding, not on
# each other. Their flagged-passage counts are where to look first. Never
# touches translate_batch.rb, PipelineJob, or the chapters/ files it
# evaluates.
#
# Usage:
#   bin/translation_eval <novel_dir> <chapter_numbers...> [--out DIR]
#
# Example:
#   bin/translation_eval idols-rewind 68 74 75 --out tmp/translation_eval
# ---------------------------------------------------------------------------

require_relative "../config/environment"

args = ARGV.dup
out_index = args.index("--out")
output_dir = out_index ? args.delete_at(out_index + 1).tap { args.delete_at(out_index) } : "tmp/translation_eval"

if args.size < 2
  abort "Usage: bin/translation_eval <novel_dir> <chapter_numbers...> [--out DIR]"
end

novel_dir = File.expand_path(args.shift, Rails.root)
chapter_numbers = args.map(&:to_i)
output_dir = File.expand_path(output_dir, Rails.root)

unless Dir.exist?(novel_dir)
  abort "No such novel directory: #{novel_dir}"
end

puts "Novel dir:  #{novel_dir}"
puts "Chapters:   #{chapter_numbers.join(', ')}"
puts "Output dir: #{output_dir}"
puts

results = Pipeline::Ruby::TranslationEval.call(
  novel_dir: novel_dir, chapter_numbers: chapter_numbers, output_dir: output_dir
)

def stage_status(error, valid_json, coverage_error, flagged_count: nil)
  if error&.start_with?("skipped:")
    error
  elsif error
    "FAILED — #{error}"
  elsif valid_json == false
    "ok (call succeeded, JSON invalid)"
  elsif coverage_error
    "JSON ok, coverage FAILED — #{coverage_error}"
  elsif flagged_count
    "ok (#{flagged_count} passage(s) flagged)"
  else
    "ok"
  end
end

results.each do |r|
  if r.missing_source
    puts "Chapter #{r.number}: SKIPPED (no Korean source)"
    next
  end

  puts "Chapter #{r.number}:"
  puts "  segmentation: #{stage_status(r.segmentation_error, r.segmentation_valid_json, r.segmentation_coverage_error)}"
  puts "  analysis:     #{stage_status(r.analysis_error, r.analysis_valid_json, r.analysis_coverage_error)}"
  puts "  localization: #{stage_status(r.localization_error, r.localization_valid_json, r.localization_coverage_error)}"
  puts "  factcheck:    #{stage_status(r.factcheck_error, r.factcheck_valid_json, r.factcheck_coverage_error, flagged_count: r.factcheck_flagged_count)}"
  puts "  editor:       #{stage_status(r.editor_error, r.editor_valid_json, r.editor_coverage_error, flagged_count: r.editor_flagged_count)}"
end

puts
puts "Compare outputs under #{output_dir}/chapter_<N>/"
